<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="page-body">
    <div class="container">
        <!-- Breadcrumb & Top Bar -->
        <div class="page-header">
            <div>
                <div class="breadcrumb">
                    <a href="/">Infrastructure</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">Devices</span>
                </div>
                <h1 class="page-title">Device Registry</h1>
                <p class="page-subtitle">Authoritative hardware inventory, layer-3 management endpoints, and credential associations.</p>
            </div>
            <div class="header-actions">
                <button type="button" class="btn btn-primary" id="open-device-modal-btn">
                    <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                    </svg>
                    <span>Add Device</span>
                </button>
            </div>
        </div>

        <% if (query && query.success) { %>
            <div class="alert alert-success" role="alert">
                <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>
                    <% if (query.success === 'created') { %>
                        Network device registered successfully in PostgreSQL inventory.
                    <% } else if (query.success === 'updated') { %>
                        Device parameters successfully updated.
                    <% } else if (query.success === 'deleted') { %>
                        Device record removed from registry.
                    <% } else { %>
                        Operation executed successfully.
                    <% } %>
                </span>
            </div>
        <% } %>

        <% if (query && query.error) { %>
            <div class="alert alert-danger" role="alert">
                <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span><%= query.error %></span>
            </div>
        <% } %>

        <!-- Metrics Overview -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Devices</div>
                <div class="stat-value"><%= devices.length %></div>
                <div class="stat-desc">Registered network hardware nodes</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Bound Credentials</div>
                <div class="stat-value"><%= devices.reduce((acc, d) => acc + (d.credential_count || 0), 0) %></div>
                <div class="stat-desc">Vault records linked via LEFT JOIN</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">IP Allocations</div>
                <div class="stat-value"><%= devices.reduce((acc, d) => acc + (d.ip_count || 0), 0) %></div>
                <div class="stat-desc">Host interfaces bound via LEFT JOIN</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Routed Elements</div>
                <div class="stat-value"><%= devices.filter(d => d.device_role && d.device_role.includes('Router')).length %></div>
                <div class="stat-desc">Core & Edge routing hardware</div>
            </div>
        </div>

        <!-- Devices Data Table Card -->
        <div class="card mt-24">
            <div class="card-header flex-between">
                <div>
                    <h2 class="card-title">Registered Network Hardware</h2>
                    <p class="card-subtitle">Authoritative hardware inventory in PostgreSQL <code>devices</code> relation with relational counts.</p>
                </div>
                <div class="table-actions-group">
                    <input type="text" id="device-filter-input" class="search-input" placeholder="Filter by hostname, role, IP..." aria-label="Filter devices">
                    <button type="button" class="btn btn-primary" id="table-add-device-btn">
                        + Add Device
                    </button>
                </div>
            </div>

            <div class="card-body no-padding">
                <% if (devices.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon-wrap">
                            <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                                <line x1="6" y1="6" x2="6.01" y2="6"></line>
                                <line x1="6" y1="18" x2="6.01" y2="18"></line>
                            </svg>
                        </div>
                        <h3 class="empty-title">No Devices Registered</h3>
                        <p class="empty-desc">Your database currently has 0 device records. Add your first router, switch, or firewall to bind management endpoints and credentials.</p>
                        <button type="button" class="btn btn-primary mt-16" id="empty-add-device-btn">
                            + Add First Device
                        </button>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="data-table" id="devices-table">
                            <thead>
                                <tr>
                                    <th scope="col">Hostname</th>
                                    <th scope="col">Device Role</th>
                                    <th scope="col">Management IP</th>
                                    <th scope="col">Bound Credentials</th>
                                    <th scope="col">IP Allocations</th>
                                    <th scope="col" class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% devices.forEach(dev => { %>
                                    <tr id="device-row-<%= dev.id %>" data-search-target="<%= (dev.hostname + ' ' + (dev.device_role || '') + ' ' + (dev.management_ip || '')).toLowerCase() %>">
                                        <td class="cell-hostname">
                                            <div class="device-cell-group">
                                                <span class="font-bold"><%= dev.hostname %></span>
                                            </div>
                                        </td>
                                        <td class="cell-role">
                                            <span class="badge badge-vlan">
                                                <%= dev.device_role %>
                                            </span>
                                        </td>
                                        <td class="cell-management-ip">
                                            <% if (dev.management_ip) { %>
                                                <div class="actions-inline">
                                                    <span class="badge badge-cidr font-mono"><%= dev.management_ip %></span>
                                                    <button type="button" class="btn-copy" data-copy="<%= dev.management_ip %>" title="Copy Management IP">Copy</button>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted text-sm italic">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td class="cell-credentials">
                                            <span class="badge <%= dev.credential_count > 0 ? 'badge-info' : 'badge-neutral' %> font-mono">
                                                <%= dev.credential_count %> <%= dev.credential_count === 1 ? 'credential' : 'credentials' %>
                                            </span>
                                        </td>
                                        <td class="cell-allocations">
                                            <span class="badge <%= dev.ip_count > 0 ? 'badge-info' : 'badge-neutral' %> font-mono">
                                                <%= dev.ip_count %> <%= dev.ip_count === 1 ? 'allocation' : 'allocations' %>
                                            </span>
                                        </td>
                                        <td class="cell-actions text-right">
                                            <div class="actions-inline">
                                                <button 
                                                    type="button" 
                                                    class="btn-edit" 
                                                    data-id="<%= dev.id %>" 
                                                    data-hostname="<%= dev.hostname %>" 
                                                    data-role="<%= dev.device_role %>"
                                                    data-ip="<%= dev.management_ip || '' %>"
                                                    title="Edit device parameters"
                                                >
                                                    Edit
                                                </button>
                                                <button 
                                                    type="button" 
                                                    class="btn-release" 
                                                    data-id="<%= dev.id %>" 
                                                    data-hostname="<%= dev.hostname %>"
                                                    title="Delete device"
                                                >
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<!-- Add Device Modal -->
<div class="modal-backdrop" id="add-device-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="add-device-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="add-device-title">Register Network Device</h3>
                    <p class="modal-subtitle">Add hardware node to Netgrid NSoT registry.</p>
                </div>
                <button type="button" class="modal-close-btn" id="close-add-device-x" aria-label="Close dialog">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>

            <form id="add-device-form" method="POST" action="/devices" novalidate>
                <div class="modal-body">
                    <!-- Dynamic Alert Inside Modal -->
                    <div class="alert alert-danger hidden" id="add-device-alert" role="alert">
                        <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <span id="add-device-alert-text">Error message</span>
                    </div>

                    <!-- Hostname -->
                    <div class="form-group">
                        <label for="add-device-hostname" class="form-label">
                            Hostname (FQDN) <span class="required-asterisk">*</span>
                        </label>
                        <input 
                            type="text" 
                            id="add-device-hostname" 
                            name="hostname" 
                            class="form-control font-mono" 
                            placeholder="e.g. cr01.sfo.netgrid.internal" 
                            required 
                            autocomplete="off"
                            spellcheck="false"
                        >
                        <p class="form-hint">Unique network device identifier or fully qualified domain name.</p>
                    </div>

                    <!-- Strict Device Role HTML Select -->
                    <div class="form-group">
                        <label for="add-device-role" class="form-label">
                            Device Role <span class="required-asterisk">*</span>
                        </label>
                        <select id="add-device-role" name="device_role" class="form-control" required>
                            <option value="" disabled selected>Select hardware role...</option>
                            <option value="Core Router">Core Router</option>
                            <option value="Edge Router">Edge Router</option>
                            <option value="Distribution Switch">Distribution Switch</option>
                            <option value="Access Switch">Access Switch</option>
                            <option value="Firewall">Firewall</option>
                            <option value="Load Balancer">Load Balancer</option>
                        </select>
                        <p class="form-hint">Strict structural categorization of device architecture.</p>
                    </div>

                    <!-- Management IP -->
                    <div class="form-group">
                        <label for="add-device-mgmt-ip" class="form-label">
                            Management IP Address <span class="optional-tag">(Optional)</span>
                        </label>
                        <input 
                            type="text" 
                            id="add-device-mgmt-ip" 
                            name="management_ip" 
                            class="form-control font-mono" 
                            placeholder="e.g. 10.100.0.1 or 192.168.10.254" 
                            autocomplete="off"
                            spellcheck="false"
                        >
                        <p class="form-hint">Out-of-band or in-band layer-3 management IP.</p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancel-add-device-btn">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submit-add-device-btn">
                        <span class="btn-spinner hidden" id="spinner-add-device" aria-hidden="true"></span>
                        <span id="label-add-device">Register Device</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Device Modal -->
<div class="modal-backdrop" id="edit-device-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="edit-device-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="edit-device-title">Edit Network Device</h3>
                    <p class="modal-subtitle">Update hardware parameters in Netgrid NSoT.</p>
                </div>
                <button type="button" class="modal-close-btn" id="close-edit-device-x" aria-label="Close dialog">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>

            <form id="edit-device-form" method="POST" action="" novalidate>
                <div class="modal-body">
                    <!-- Dynamic Alert Inside Modal -->
                    <div class="alert alert-danger hidden" id="edit-device-alert" role="alert">
                        <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <span id="edit-device-alert-text">Error message</span>
                    </div>

                    <!-- Hidden ID input -->
                    <input type="hidden" id="edit-device-id-hidden" name="id">

                    <!-- Hostname -->
                    <div class="form-group">
                        <label for="edit-device-hostname" class="form-label">
                            Hostname (FQDN) <span class="required-asterisk">*</span>
                        </label>
                        <input 
                            type="text" 
                            id="edit-device-hostname" 
                            name="hostname" 
                            class="form-control font-mono" 
                            required 
                            autocomplete="off"
                            spellcheck="false"
                        >
                        <p class="form-hint">Unique network device identifier.</p>
                    </div>

                    <!-- Strict Device Role HTML Select -->
                    <div class="form-group">
                        <label for="edit-device-role" class="form-label">
                            Device Role <span class="required-asterisk">*</span>
                        </label>
                        <select id="edit-device-role" name="device_role" class="form-control" required>
                            <option value="Core Router">Core Router</option>
                            <option value="Edge Router">Edge Router</option>
                            <option value="Distribution Switch">Distribution Switch</option>
                            <option value="Access Switch">Access Switch</option>
                            <option value="Firewall">Firewall</option>
                            <option value="Load Balancer">Load Balancer</option>
                        </select>
                        <p class="form-hint">Strict structural categorization of device architecture.</p>
                    </div>

                    <!-- Management IP -->
                    <div class="form-group">
                        <label for="edit-device-mgmt-ip" class="form-label">
                            Management IP Address <span class="optional-tag">(Optional)</span>
                        </label>
                        <input 
                            type="text" 
                            id="edit-device-mgmt-ip" 
                            name="management_ip" 
                            class="form-control font-mono" 
                            autocomplete="off"
                            spellcheck="false"
                        >
                        <p class="form-hint">Out-of-band or in-band layer-3 management IP.</p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancel-edit-device-btn">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submit-edit-device-btn">
                        <span class="btn-spinner hidden" id="spinner-edit-device" aria-hidden="true"></span>
                        <span id="label-edit-device">Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function initDevicesPage() {
        const addModal = document.getElementById('add-device-modal');
        if (!addModal) return;
        if (addModal.dataset.initialized === 'true') return;
        addModal.dataset.initialized = 'true';

        const openAddBtn = document.getElementById('open-device-modal-btn');
        const tableAddBtn = document.getElementById('table-add-device-btn');
        const emptyAddBtn = document.getElementById('empty-add-device-btn');
        const closeAddX = document.getElementById('close-add-device-x');
        const cancelAddBtn = document.getElementById('cancel-add-device-btn');
        const addForm = document.getElementById('add-device-form');
        const addHostname = document.getElementById('add-device-hostname');
        const addRole = document.getElementById('add-device-role');
        const addMgmtIp = document.getElementById('add-device-mgmt-ip');
        const addAlertBox = document.getElementById('add-device-alert');
        const addAlertText = document.getElementById('add-device-alert-text');
        const submitAddBtn = document.getElementById('submit-add-device-btn');
        const labelAddBtn = document.getElementById('label-add-device');
        const spinnerAdd = document.getElementById('spinner-add-device');

        // Edit Modal Elements
        const editModal = document.getElementById('edit-device-modal');
        const closeEditX = document.getElementById('close-edit-device-x');
        const cancelEditBtn = document.getElementById('cancel-edit-device-btn');
        const editForm = document.getElementById('edit-device-form');
        const editIdHidden = document.getElementById('edit-device-id-hidden');
        const editHostname = document.getElementById('edit-device-hostname');
        const editRole = document.getElementById('edit-device-role');
        const editMgmtIp = document.getElementById('edit-device-mgmt-ip');
        const editAlertBox = document.getElementById('edit-device-alert');
        const editAlertText = document.getElementById('edit-device-alert-text');
        const submitEditBtn = document.getElementById('submit-edit-device-btn');
        const labelEditBtn = document.getElementById('label-edit-device');
        const spinnerEdit = document.getElementById('spinner-edit-device');

        // Filter
        const filterInput = document.getElementById('device-filter-input');

        // Open Add Modal
        function openAddModal() {
            addModal.classList.add('is-active');
            addModal.setAttribute('aria-hidden', 'false');
            addAlertBox.classList.add('hidden');
            addForm.reset();
            setTimeout(() => addHostname.focus(), 50);
        }

        // Close Add Modal
        function closeAddModal() {
            addModal.classList.remove('is-active');
            addModal.setAttribute('aria-hidden', 'true');
            addAlertBox.classList.add('hidden');
            submitAddBtn.disabled = false;
            spinnerAdd.classList.add('hidden');
            labelAddBtn.textContent = 'Register Device';
        }

        // Open Edit Modal
        function openEditModal(id, hostname, role, ip) {
            editIdHidden.value = id;
            editHostname.value = hostname;
            editRole.value = role;
            editMgmtIp.value = ip;
            editForm.action = '/devices/' + id + '/edit';
            editModal.classList.add('is-active');
            editModal.setAttribute('aria-hidden', 'false');
            editAlertBox.classList.add('hidden');
            setTimeout(() => editHostname.focus(), 50);
        }

        // Close Edit Modal
        function closeEditModal() {
            editModal.classList.remove('is-active');
            editModal.setAttribute('aria-hidden', 'true');
            editAlertBox.classList.add('hidden');
            submitEditBtn.disabled = false;
            spinnerEdit.classList.add('hidden');
            labelEditBtn.textContent = 'Save Changes';
        }

        if (openAddBtn) openAddBtn.addEventListener('click', openAddModal);
        if (tableAddBtn) tableAddBtn.addEventListener('click', openAddModal);
        if (emptyAddBtn) emptyAddBtn.addEventListener('click', openAddModal);
        if (closeAddX) closeAddX.addEventListener('click', closeAddModal);
        if (cancelAddBtn) cancelAddBtn.addEventListener('click', closeAddModal);

        if (closeEditX) closeEditX.addEventListener('click', closeEditModal);
        if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);

        // Backdrop click handling
        addModal.addEventListener('click', (e) => {
            if (e.target === addModal) closeAddModal();
        });

        editModal.addEventListener('click', (e) => {
            if (e.target === editModal) closeEditModal();
        });

        // Escape key handling
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (addModal.classList.contains('is-active')) closeAddModal();
                if (editModal.classList.contains('is-active')) closeEditModal();
            }
        });

        // Add Device Submit
        addForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            addAlertBox.classList.add('hidden');

            const hostVal = addHostname.value.trim();
            const roleVal = addRole.value;
            const ipVal = addMgmtIp.value.trim();

            if (!hostVal) {
                addAlertText.textContent = 'Hostname is required.';
                addAlertBox.classList.remove('hidden');
                addHostname.focus();
                return;
            }

            if (!roleVal) {
                addAlertText.textContent = 'Device Role must be selected from the predefined list.';
                addAlertBox.classList.remove('hidden');
                addRole.focus();
                return;
            }

            submitAddBtn.disabled = true;
            spinnerAdd.classList.remove('hidden');
            labelAddBtn.textContent = 'Registering...';

            try {
                const response = await fetch('/devices', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                    },
                    body: JSON.stringify({
                        hostname: hostVal,
                        device_role: roleVal,
                        management_ip: ipVal || null,
                    }),
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    window.location.href = '/devices?success=created';
                } else {
                    addAlertText.textContent = data.error || 'Failed to register device.';
                    addAlertBox.classList.remove('hidden');
                    submitAddBtn.disabled = false;
                    spinnerAdd.classList.add('hidden');
                    labelAddBtn.textContent = 'Register Device';
                }
            } catch (err) {
                console.error(err);
                addAlertText.textContent = 'Network error communicating with Netgrid server.';
                addAlertBox.classList.remove('hidden');
                submitAddBtn.disabled = false;
                spinnerAdd.classList.add('hidden');
                labelAddBtn.textContent = 'Register Device';
            }
        });

        // Edit Device Button Click
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-id');
                const hostname = btn.getAttribute('data-hostname');
                const role = btn.getAttribute('data-role');
                const ip = btn.getAttribute('data-ip');
                openEditModal(id, hostname, role, ip);
            });
        });

        // Edit Device Submit
        editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            editAlertBox.classList.add('hidden');

            const hostVal = editHostname.value.trim();
            const roleVal = editRole.value;
            const ipVal = editMgmtIp.value.trim();

            if (!hostVal) {
                editAlertText.textContent = 'Hostname is required.';
                editAlertBox.classList.remove('hidden');
                editHostname.focus();
                return;
            }

            if (!roleVal) {
                editAlertText.textContent = 'Device Role must be selected from the predefined list.';
                editAlertBox.classList.remove('hidden');
                editRole.focus();
                return;
            }

            submitEditBtn.disabled = true;
            spinnerEdit.classList.remove('hidden');
            labelEditBtn.textContent = 'Saving...';

            try {
                const response = await fetch(editForm.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                    },
                    body: JSON.stringify({
                        hostname: hostVal,
                        device_role: roleVal,
                        management_ip: ipVal || null,
                    }),
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    window.location.href = '/devices?success=updated';
                } else {
                    editAlertText.textContent = data.error || 'Failed to update device.';
                    editAlertBox.classList.remove('hidden');
                    submitEditBtn.disabled = false;
                    spinnerEdit.classList.add('hidden');
                    labelEditBtn.textContent = 'Save Changes';
                }
            } catch (err) {
                console.error(err);
                editAlertText.textContent = 'Network error communicating with Netgrid server.';
                editAlertBox.classList.remove('hidden');
                submitEditBtn.disabled = false;
                spinnerEdit.classList.add('hidden');
                labelEditBtn.textContent = 'Save Changes';
            }
        });

        // Delete Device Action
        document.querySelectorAll('.btn-release').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                const hostname = btn.getAttribute('data-hostname');

                if (!confirm(`Are you sure you want to delete ${hostname}? Any bound credentials will be cascaded, and associated IP addresses will be unbound.`)) {
                    return;
                }

                try {
                    const response = await fetch(`/devices/${id}/delete`, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                        },
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = '/devices?success=deleted';
                    } else {
                        alert(data.error || 'Failed to delete device.');
                    }
                } catch (err) {
                    console.error('Delete failed:', err);
                    alert('Network error communicating with Netgrid server.');
                }
            });
        });

        // Filter Table Rows
        if (filterInput) {
            filterInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase().trim();
                const rows = document.querySelectorAll('#devices-table tbody tr');
                rows.forEach(row => {
                    const searchTarget = row.getAttribute('data-search-target') || '';
                    if (searchTarget.includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }

        // Copy IP
        document.querySelectorAll('.btn-copy').forEach(btn => {
            btn.addEventListener('click', async () => {
                const copyText = btn.getAttribute('data-copy');
                if (copyText) {
                    try {
                        await navigator.clipboard.writeText(copyText);
                        const original = btn.textContent;
                        btn.textContent = 'Copied!';
                        btn.classList.add('copied');
                        setTimeout(() => {
                            btn.textContent = original;
                            btn.classList.remove('copied');
                        }, 1800);
                    } catch (err) {
                        console.error('Copy failed:', err);
                    }
                }
            });
        });
    }
    window.initDevicesPage = initDevicesPage;
    if (document.readyState === 'loading') {
        document.addEventListener("DOMContentLoaded", initDevicesPage);
    } else {
        initDevicesPage();
    }
</script>

<%- include('partials/footer') %>
