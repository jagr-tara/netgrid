<header class="app-header">
    <div class="header-container">
        <div class="brand-group">
            <a href="/" class="brand-logo" aria-label="Netgrid Home">
                <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="8" height="8" rx="2"></rect>
                    <rect x="14" y="2" width="8" height="8" rx="2"></rect>
                    <rect x="2" y="14" width="8" height="8" rx="2"></rect>
                    <rect x="14" y="14" width="8" height="8" rx="2"></rect>
                    <line x1="6" y1="10" x2="6" y2="14"></line>
                    <line x1="18" y1="10" x2="18" y2="14"></line>
                    <line x1="10" y1="6" x2="14" y2="6"></line>
                    <line x1="10" y1="18" x2="14" y2="18"></line>
                </svg>
                <span class="brand-name">NETGRID</span>
                <span class="brand-badge">NSoT</span>
            </a>
        </div>
        <nav class="main-nav" aria-label="Main Navigation">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="/" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="/ipam" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/ipam') ? 'active' : '' %>">IPAM</a>
                </li>
                <li class="nav-item">
                    <a href="/vlans" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/vlans') ? 'active' : '' %>">VLANs</a>
                </li>
                <li class="nav-item">
                    <a href="/devices" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/devices') ? 'active' : '' %>">Devices</a>
                </li>
                <li class="nav-item">
                    <a href="/topology" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/topology') ? 'active' : '' %>">Topology</a>
                </li>
                <li class="nav-item">
                    <a href="/credentials" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/credentials') ? 'active' : '' %>">Credentials</a>
                </li>
            </ul>
        </nav>
        <div class="header-status">
            <span class="status-indicator" title="Connected to PostgreSQL Engine">
                <span class="status-dot"></span>
                <span class="status-text">PostgreSQL 15</span>
            </span>
        </div>
    </div>
</header>
