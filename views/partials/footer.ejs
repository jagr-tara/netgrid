            </div><!-- /#swup -->
            <footer class="app-footer">
                <div class="footer-container">
                    <div class="footer-left">
                        <div class="footer-brand">
                            <span class="footer-brand-title">Netgrid NSoT</span>
                            <span class="footer-version-tag">v1.2.0</span>
                            <span class="footer-sep">&bull;</span>
                            <span class="footer-copyright">&copy; <%= new Date().getFullYear() %> Netgrid Systems</span>
                        </div>
                    </div>
                    <div class="footer-dock-wrap">
                        <div class="floating-dock-pill">
                            <span class="dock-indicator-dot"></span>
                            <span class="dock-meta-item">Host Limit: <strong>3,072 MB</strong></span>
                            <span class="dock-divider"></span>
                            <span class="dock-meta-item">DB: <strong>PostgreSQL 15</strong></span>
                            <span class="dock-divider"></span>
                            <span class="dock-meta-item">Engine: <strong>Node.js RESTful</strong></span>
                        </div>
                    </div>
                </div>
            </footer>
        </div><!-- /.app-canvas -->
    </div><!-- /.app-frame -->

    <!-- Navigation Progress Indicator -->
    <div id="netgrid-nav-progress" class="nav-progress-bar" aria-hidden="true"></div>

    <!-- vis-network Canvas Graph Engine (CDN with local fallback) -->
    <script src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>
    <script>if (typeof window.vis === 'undefined') document.write('<script src="/js/vis-network.min.js"><\/script>');</script>

    <!-- Swup.js Transition Engine & Scripts Plugin -->
    <script src="/js/swup.umd.js"></script>
    <script src="/js/swup-scripts-plugin.umd.js"></script>
    <script>
        (function() {
            const progressBar = document.getElementById('netgrid-nav-progress');

            // Central remount dispatcher for page-specific dynamic logic
            function remountActivePageScripts() {
                // Dashboard Time
                if (document.getElementById('local-time') && typeof window.initDashboardPage === 'function') {
                    try { window.initDashboardPage(); } catch (e) { console.error('Dashboard init error:', e); }
                }
                // IPAM Subnets & Modal
                if (document.getElementById('subnet-modal') && typeof window.initIpamPage === 'function') {
                    try { window.initIpamPage(); } catch (e) { console.error('IPAM init error:', e); }
                }
                // VLANs Table & Modals
                if (document.getElementById('add-vlan-modal') && typeof window.initVlansPage === 'function') {
                    try { window.initVlansPage(); } catch (e) { console.error('VLANs init error:', e); }
                }
                // Devices Hardware & Modals
                if (document.getElementById('add-device-modal') && typeof window.initDevicesPage === 'function') {
                    try { window.initDevicesPage(); } catch (e) { console.error('Devices init error:', e); }
                }
                // Subnet Detail Space Map & Assign Modal
                if ((document.getElementById('space-map-grid') || document.getElementById('assign-ip-modal')) && typeof window.initSubnetDetailPage === 'function') {
                    try { window.initSubnetDetailPage(); } catch (e) { console.error('Subnet detail init error:', e); }
                }
                // Topology Graph Canvas Engine
                if (document.getElementById('topology-canvas-viewport') && typeof window.initTopologyPage === 'function') {
                    try { window.initTopologyPage(); } catch (e) { console.error('Topology init error:', e); }
                }
                // Credentials Vault Table & Modal
                if (document.getElementById('add-credential-modal') && typeof window.initCredentialsPage === 'function') {
                    try { window.initCredentialsPage(); } catch (e) { console.error('Credentials init error:', e); }
                }
                // Network Flow Matrix Table & Modal
                if (document.getElementById('add-flow-modal') && typeof window.initFlowsPage === 'function') {
                    try { window.initFlowsPage(); } catch (e) { console.error('Flows init error:', e); }
                }
            }
            window.remountActivePageScripts = remountActivePageScripts;

            // Synchronize floating navbar active indicators on client transition
            function updateActiveNav() {
                const currentPath = window.location.pathname;
                document.querySelectorAll('.floating-pill-list .nav-pill').forEach(pill => {
                    const href = pill.getAttribute('href');
                    const isActive = (href === '/' && currentPath === '/') || (href !== '/' && currentPath.startsWith(href));
                    pill.classList.toggle('active', isActive);
                });

                const scopePill = document.querySelector('.header-scope-pill');
                if (scopePill) {
                    scopePill.textContent = currentPath === '/' ? 'CONSOLE' : currentPath.split('/')[1].toUpperCase();
                }
            }

            // Initialize Swup Engine
            if (typeof window.Swup !== 'undefined') {
                const plugins = [];
                if (typeof window.SwupScriptsPlugin !== 'undefined') {
                    plugins.push(new window.SwupScriptsPlugin({
                        head: false,
                        body: true,
                        optin: false
                    }));
                }

                const swup = new window.Swup({
                    containers: ['#swup'],
                    animationSelector: '[class*="transition-"]',
                    cache: true,
                    plugins: plugins,
                    linkSelector: 'a[href]:not([data-no-swup]):not([target="_blank"]):not([href^="#"]):not([href^="javascript:"])'
                });

                // Top progress feedback & dismiss open dialogs on navigation
                swup.hooks.on('visit:start', () => {
                    if (progressBar) {
                        progressBar.classList.remove('done');
                        progressBar.classList.add('active');
                    }
                    document.querySelectorAll('.modal-backdrop.is-active').forEach(m => m.classList.remove('is-active'));

                    // Teardown topology canvas instance to prevent memory leaks during rapid navigation
                    if (window.currentTopologyNetwork) {
                        try {
                            window.currentTopologyNetwork.destroy();
                        } catch (e) {
                            console.warn('Canvas teardown warning:', e);
                        }
                        window.currentTopologyNetwork = null;
                    }
                });

                swup.hooks.on('visit:end', () => {
                    if (progressBar) {
                        progressBar.classList.add('done');
                        setTimeout(() => {
                            progressBar.classList.remove('active', 'done');
                        }, 200);
                    }
                });

                // Re-mount page scripts & update navbar active state after swap
                swup.hooks.on('page:view', () => {
                    updateActiveNav();
                    remountActivePageScripts();
                });

                swup.hooks.on('content:replace', () => {
                    remountActivePageScripts();
                });

                window.netgridSwup = swup;
            }

            // Universal modal dismiss on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-backdrop.is-active').forEach(m => m.classList.remove('is-active'));
                }
            });

            // Universal modal dismiss on backdrop click
            document.addEventListener('click', (e) => {
                if (e.target && e.target.classList && e.target.classList.contains('modal-backdrop') && e.target.classList.contains('is-active')) {
                    e.target.classList.remove('is-active');
                }
            });
        })();
    </script>
</body>
</html>
