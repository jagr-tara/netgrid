<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="page-body">
    <div class="container">
        <!-- Breadcrumb & Top Bar -->
        <div class="page-header">
            <div>
                <div class="breadcrumb">
                    <a href="/">Infrastructure</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">Credentials</span>
                </div>
                <h1 class="page-title">Credentials Vault</h1>
                <p class="page-subtitle">Zero-exposure hardware credentials protected by native AES-256-GCM authenticated encryption.</p>
            </div>
            <div class="header-actions">
                <button type="button" class="btn btn-primary" id="open-cred-modal-btn">
                    <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                    </svg>
                    <span>Add Credential</span>
                </button>
            </div>
        </div>

        <% if (query && query.success) { %>
            <div class="alert alert-success" role="alert">
                <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>
                    <% if (query.success === 'created') { %>
                        Credential encrypted with AES-256-GCM and stored securely in vault.
                    <% } else if (query.success === 'deleted') { %>
                        Credential record purged from vault.
                    <% } else { %>
                        Operation executed successfully.
                    <% } %>
                </span>
            </div>
        <% } %>

        <% if (query && query.error) { %>
            <div class="alert alert-danger" role="alert">
                <svg class="alert-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span><%= query.error %></span>
            </div>
        <% } %>

        <!-- Metrics Overview -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Vault Keys</div>
                <div class="stat-value"><%= credentials.length %></div>
                <div class="stat-desc">Encrypted secret records</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Bound Hardware</div>
                <div class="stat-value"><%= credentials.filter(c => c.device_id !== null).length %></div>
                <div class="stat-desc">Linked to active routing nodes</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">SSH Protocol Keys</div>
                <div class="stat-value"><%= credentials.filter(c => c.protocol.toUpperCase() === 'SSH').length %></div>
                <div class="stat-desc">Secure Shell access profiles</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Zero-Exposure State</div>
                <div class="stat-value" style="font-size: 16px; font-weight: 700; color: #0F5144;">
                    <span class="status-dot status-dot-emerald" style="display: inline-block; vertical-align: middle; margin-right: 6px;"></span>
                    AES-256-GCM
                </div>
                <div class="stat-desc">32-byte authenticated cipher</div>
            </div>
        </div>

        <!-- Credentials Data Table Card -->
        <div class="card mt-24">
            <div class="card-header flex-between">
                <div>
                    <h2 class="card-title">Hardware Authentication Vault</h2>
                    <p class="card-subtitle">Encrypted layer-3 secrets bound to physical and virtual network hardware.</p>
                </div>
                <div class="table-actions-group">
                    <input type="text" id="credential-filter-input" class="search-input" placeholder="Filter by device, user, protocol..." aria-label="Filter credentials">
                    <button type="button" class="btn btn-primary" id="table-add-cred-btn">
                        + Add Credential
                    </button>
                </div>
            </div>

            <div class="card-body no-padding">
                <% if (credentials.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon-wrap">
                            <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <h3 class="empty-title">No credentials in vault</h3>
                        <p class="empty-desc">Store hardware management secrets encrypted with AES-256-GCM authenticated cipher.</p>
                        <button type="button" class="btn btn-primary" id="empty-add-cred-btn">
                            Add First Credential
                        </button>
                    </div>
                <% } else { %>
                    <div class="table-container">
                        <table class="data-table" id="credentials-table">
                            <thead>
                                <tr>
                                    <th scope="col">Target Device</th>
                                    <th scope="col">Username</th>
                                    <th scope="col">Protocol</th>
                                    <th scope="col">Secret Payload (Zero-Exposure)</th>
                                    <th scope="col" class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% credentials.forEach(cred => { %>
                                    <tr id="cred-row-<%= cred.id %>" data-search-target="<%= (cred.device_hostname + ' ' + cred.username + ' ' + cred.protocol + ' ' + (cred.device_role || '')).toLowerCase() %>">
                                        <td class="cell-device">
                                            <div class="device-cell-group">
                                                <span class="font-bold"><%= cred.device_hostname %></span>
                                                <% if (cred.device_role) { %>
                                                    <span class="badge badge-neutral" style="font-size: 11px; margin-left: 6px;"><%= cred.device_role %></span>
                                                <% } %>
                                                <% if (cred.device_management_ip) { %>
                                                    <span class="text-muted font-mono" style="font-size: 11.5px; margin-left: 6px;"><%= cred.device_management_ip %></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="cell-username">
                                            <span class="font-mono font-bold" style="color: var(--text-main);"><%= cred.username %></span>
                                        </td>
                                        <td class="cell-protocol">
                                            <span class="badge badge-cyan" style="font-family: var(--font-mono); font-size: 11.5px;">
                                                <%= cred.protocol %>
                                            </span>
                                        </td>
                                        <td class="cell-payload">
                                            <div class="actions-inline">
                                                <span class="badge badge-neutral font-mono secret-mask-text" id="payload-mask-<%= cred.id %>" style="letter-spacing: 2px;">
                                                    <%= cred.masked_payload %>
                                                </span>
                                                <button 
                                                    type="button" 
                                                    class="btn-copy btn-reveal-secret" 
                                                    data-id="<%= cred.id %>" 
                                                    title="Securely decrypt and copy secret to clipboard"
                                                >
                                                    Copy Secret
                                                </button>
                                            </div>
                                        </td>
                                        <td class="cell-actions text-right">
                                            <div class="actions-inline">
                                                <button 
                                                    type="button" 
                                                    class="btn-release btn-delete-cred" 
                                                    data-id="<%= cred.id %>" 
                                                    data-device="<%= cred.device_hostname %>"
                                                    data-user="<%= cred.username %>"
                                                    title="Purge credential from vault"
                                                >
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<!-- Add Credential Modal Dialog -->
<div class="modal-backdrop" id="add-credential-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="add-cred-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="add-cred-title">Store Encrypted Credential</h3>
                    <p class="modal-subtitle">Payload encrypted with native AES-256-GCM cipher prior to SQL insertion.</p>
                </div>
                <button type="button" class="modal-close-btn" id="close-add-cred-x" aria-label="Close dialog">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>

            <form id="add-credential-form" method="POST" action="/credentials" novalidate>
                <div class="modal-body">
                    <div id="add-cred-alert-container"></div>

                    <!-- Target Device Select Dropdown (Populated with Active Hostnames) -->
                    <div class="form-group">
                        <label for="cred-device-id" class="form-label">
                            Target Hardware Device
                            <span class="text-muted" style="font-weight: normal; font-size: 12px;">(Routing Node Binding)</span>
                        </label>
                        <select id="cred-device-id" name="device_id" class="form-select">
                            <option value="">-- Unbound / Global Network Secret --</option>
                            <% devices.forEach(dev => { %>
                                <option value="<%= dev.id %>">
                                    <%= dev.hostname %> &bull; <%= dev.device_role || 'Node' %> <%= dev.management_ip ? `(${dev.management_ip})` : '' %>
                                </option>
                            <% }) %>
                        </select>
                        <p class="form-hint">Binds this secret to an authoritative hardware node in PostgreSQL <code>devices</code> relation.</p>
                    </div>

                    <!-- Username Field -->
                    <div class="form-group">
                        <label for="cred-username" class="form-label">
                            Username / Principal <span class="required-mark">*</span>
                        </label>
                        <input 
                            type="text" 
                            id="cred-username" 
                            name="username" 
                            class="form-input" 
                            placeholder="e.g. netops_admin or cisco" 
                            required 
                            autocomplete="off"
                        >
                        <div class="form-error-feedback" id="cred-username-error"></div>
                    </div>

                    <!-- Protocol Select Dropdown -->
                    <div class="form-group">
                        <label for="cred-protocol" class="form-label">
                            Protocol / Authentication Type
                        </label>
                        <select id="cred-protocol" name="protocol" class="form-select">
                            <option value="ssh" selected>SSH (Secure Shell)</option>
                            <option value="snmpv3">SNMPv3 (Simple Network Management Protocol)</option>
                            <option value="https">HTTPS (Web Management API)</option>
                            <option value="netconf">NETCONF (RFC 6241)</option>
                            <option value="restconf">RESTCONF (RFC 8040)</option>
                            <option value="telnet">Telnet (Legacy Console)</option>
                            <option value="console">Console / Out-of-band Serial</option>
                        </select>
                    </div>

                    <!-- Password / Secret Payload Field -->
                    <div class="form-group">
                        <label for="cred-password" class="form-label">
                            Password / Secret Key <span class="required-mark">*</span>
                        </label>
                        <div style="position: relative;">
                            <input 
                                type="password" 
                                id="cred-password" 
                                name="password" 
                                class="form-input" 
                                placeholder="Enter access password or private passkey" 
                                required 
                                autocomplete="new-password"
                                style="padding-right: 44px;"
                            >
                            <button 
                                type="button" 
                                id="toggle-password-visibility" 
                                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; justify-content: center; padding: 4px;"
                                title="Toggle visibility"
                            >
                                <svg id="eye-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <div class="form-error-feedback" id="cred-password-error"></div>
                        <p class="form-hint" style="color: #0F5144;">
                            <span class="status-dot status-dot-emerald" style="display: inline-block; vertical-align: middle; margin-right: 4px;"></span>
                            Encrypted in memory with AES-256-GCM. Plain text is never cached or written to server logs.
                        </p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancel-add-cred-btn">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submit-add-cred-btn">
                        <span>Encrypt & Save</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal Dialog -->
<div class="modal-backdrop" id="delete-credential-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="delete-cred-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="delete-cred-title">Purge Vault Credential</h3>
                    <p class="modal-subtitle">Irreversible cryptographic record deletion.</p>
                </div>
                <button type="button" class="modal-close-btn" id="close-delete-cred-x" aria-label="Close dialog">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <p style="font-size: 13.5px; color: var(--text-body); line-height: 1.5; margin: 0 0 12px;">
                    Are you sure you want to permanently delete the vault credential for user <strong id="delete-cred-user" class="font-mono"></strong> on device <strong id="delete-cred-device" class="font-mono"></strong>?
                </p>
                <div class="alert alert-danger" style="margin: 0;">
                    <span>This action will immediately drop the encrypted ciphertext from PostgreSQL.</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancel-delete-cred-btn">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-cred-btn">
                    <span>Delete Credential</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Netgrid Credentials Vault Client Engine
     * Idempotent initialization tied into standard DOM load and Swup lifecycle hooks.
     */
    function initCredentialsPage() {
        const addModal = document.getElementById('add-credential-modal');
        const deleteModal = document.getElementById('delete-credential-modal');
        if (!addModal) return;

        // Open Add Credential Modal Buttons
        const openBtns = [
            document.getElementById('open-cred-modal-btn'),
            document.getElementById('table-add-cred-btn'),
            document.getElementById('empty-add-cred-btn'),
        ].filter(Boolean);

        openBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const form = document.getElementById('add-credential-form');
                if (form) form.reset();
                const alertContainer = document.getElementById('add-cred-alert-container');
                if (alertContainer) alertContainer.innerHTML = '';
                addModal.classList.add('is-active');
                setTimeout(() => {
                    const u = document.getElementById('cred-username');
                    if (u) u.focus();
                }, 50);
            });
        });

        // Close Add Modal Buttons
        const closeAddBtns = [
            document.getElementById('close-add-cred-x'),
            document.getElementById('cancel-add-cred-btn'),
        ].filter(Boolean);

        closeAddBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                addModal.classList.remove('is-active');
            });
        });

        // Toggle Password Input Visibility
        const togglePasswordBtn = document.getElementById('toggle-password-visibility');
        const passwordInput = document.getElementById('cred-password');
        if (togglePasswordBtn && passwordInput) {
            togglePasswordBtn.addEventListener('click', () => {
                const currentType = passwordInput.getAttribute('type');
                passwordInput.setAttribute('type', currentType === 'password' ? 'text' : 'password');
            });
        }

        // Add Credential Form Submission with Visual Feedback
        const addForm = document.getElementById('add-credential-form');
        if (addForm) {
            addForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const usernameInput = document.getElementById('cred-username');
                const passwordInput = document.getElementById('cred-password');
                const submitBtn = document.getElementById('submit-add-cred-btn');

                let hasError = false;
                if (!usernameInput || !usernameInput.value.trim()) {
                    usernameInput.classList.add('is-invalid');
                    const err = document.getElementById('cred-username-error');
                    if (err) err.textContent = 'Username is required.';
                    hasError = true;
                } else {
                    usernameInput.classList.remove('is-invalid');
                    const err = document.getElementById('cred-username-error');
                    if (err) err.textContent = '';
                }

                if (!passwordInput || !passwordInput.value.trim()) {
                    passwordInput.classList.add('is-invalid');
                    const err = document.getElementById('cred-password-error');
                    if (err) err.textContent = 'Password/Secret payload is required.';
                    hasError = true;
                } else {
                    passwordInput.classList.remove('is-invalid');
                    const err = document.getElementById('cred-password-error');
                    if (err) err.textContent = '';
                }

                if (hasError) return;

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span>Encrypting...</span>';
                }

                try {
                    const formData = new FormData(addForm);
                    const payload = {
                        device_id: formData.get('device_id'),
                        username: formData.get('username'),
                        password: formData.get('password'),
                        protocol: formData.get('protocol'),
                    };

                    const response = await fetch('/credentials', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                        },
                        body: JSON.stringify(payload),
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = '/credentials?success=created';
                    } else {
                        const alertContainer = document.getElementById('add-cred-alert-container');
                        if (alertContainer) {
                            alertContainer.innerHTML = `
                                <div class="alert alert-danger" style="margin-bottom: 16px;">
                                    <span>${data.error || 'Failed to encrypt and store credential.'}</span>
                                </div>
                            `;
                        }
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<span>Encrypt & Save</span>';
                        }
                    }
                } catch (err) {
                    console.error('Credential storage network error:', err);
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<span>Encrypt & Save</span>';
                    }
                }
            });
        }

        // On-demand Secure Decrypt & Copy Secret to Clipboard
        document.querySelectorAll('.btn-reveal-secret').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                if (!id) return;

                const originalText = btn.textContent;
                btn.textContent = 'Decrypting...';
                btn.disabled = true;

                try {
                    const response = await fetch(`/credentials/${id}/reveal`, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                        },
                    });

                    const data = await response.json();

                    if (response.ok && data.success && data.payload) {
                        await navigator.clipboard.writeText(data.payload);
                        btn.textContent = 'Copied!';
                        btn.classList.add('copied');

                        setTimeout(() => {
                            btn.textContent = originalText;
                            btn.classList.remove('copied');
                            btn.disabled = false;
                        }, 2000);
                    } else {
                        btn.textContent = 'Error';
                        setTimeout(() => {
                            btn.textContent = originalText;
                            btn.disabled = false;
                        }, 1800);
                    }
                } catch (err) {
                    console.error('Decryption reveal failed:', err);
                    btn.textContent = 'Failed';
                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.disabled = false;
                    }, 1800);
                }
            });
        });

        // Delete Credential Flow
        let activeDeleteId = null;
        document.querySelectorAll('.btn-delete-cred').forEach(btn => {
            btn.addEventListener('click', () => {
                activeDeleteId = btn.getAttribute('data-id');
                const userSpan = document.getElementById('delete-cred-user');
                const devSpan = document.getElementById('delete-cred-device');
                if (userSpan) userSpan.textContent = btn.getAttribute('data-user') || 'user';
                if (devSpan) devSpan.textContent = btn.getAttribute('data-device') || 'node';
                if (deleteModal) deleteModal.classList.add('is-active');
            });
        });

        const closeDeleteBtns = [
            document.getElementById('close-delete-cred-x'),
            document.getElementById('cancel-delete-cred-btn'),
        ].filter(Boolean);

        closeDeleteBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                if (deleteModal) deleteModal.classList.remove('is-active');
                activeDeleteId = null;
            });
        });

        const confirmDeleteBtn = document.getElementById('confirm-delete-cred-btn');
        if (confirmDeleteBtn) {
            confirmDeleteBtn.addEventListener('click', async () => {
                if (!activeDeleteId) return;

                confirmDeleteBtn.disabled = true;
                confirmDeleteBtn.innerHTML = '<span>Deleting...</span>';

                try {
                    const response = await fetch(`/credentials/${activeDeleteId}/delete`, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                        },
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = '/credentials?success=deleted';
                    } else {
                        alert(data.error || 'Failed to delete credential record.');
                        confirmDeleteBtn.disabled = false;
                        confirmDeleteBtn.innerHTML = '<span>Delete Credential</span>';
                    }
                } catch (err) {
                    console.error('Delete request failed:', err);
                    alert('Network error communicating with Netgrid server.');
                    confirmDeleteBtn.disabled = false;
                    confirmDeleteBtn.innerHTML = '<span>Delete Credential</span>';
                }
            });
        }

        // Live Table Search Filter
        const filterInput = document.getElementById('credential-filter-input');
        if (filterInput) {
            filterInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase().trim();
                const rows = document.querySelectorAll('#credentials-table tbody tr');
                rows.forEach(row => {
                    const searchTarget = row.getAttribute('data-search-target') || '';
                    if (searchTarget.includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }
    }

    // Export globally for Swup lifecycle remount hook
    window.initCredentialsPage = initCredentialsPage;

    // Direct navigation invocation
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCredentialsPage);
    } else {
        initCredentialsPage();
    }
</script>

<%- include('partials/footer') %>
